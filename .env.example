# 기본값은 외부 통신·API 비용 없는 원문 발췌 모드
LLM_BACKEND=extractive
# AI 생성 답변: ollama 또는 openai로 변경하고 서버 재시작
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# 선택 사항. 자료와 대화가 포함될 수 있으므로 본인이 사용 여부를 결정하세요.
LANGSMITH_TRACING=false

# 로컬 모델의 첫 로딩과 긴 자료 처리에 허용할 응답 대기 시간(초)
LLM_TIMEOUT_SECONDS=180
